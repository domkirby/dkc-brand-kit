{
  "$description": "Dom Kirby Creative design tokens. Single source of truth — edit this file, then run `python3 scripts/build_tokens.py`. Captured from domkirbycreative.com (Astro + Tailwind v4 theme) on 2026-10-10. W3C Design Tokens (DTCG) structure; colors and dimensions use plain string values for broad tool compatibility.",
  "color": {
    "$type": "color",
    "paper":        { "$value": "#fbf9f3", "$description": "Page and header background — the warm cream ground." },
    "paper-2":      { "$value": "#f3f0e7", "$description": "Alternate section band; eyebrow badge fill." },
    "surface":      { "$value": "#ffffff", "$description": "Raised panels on paper (pricing cells). Hardcoded white on the site." },
    "ink":          { "$value": "#171717", "$description": "Default text, h2/h3, nav. 17:1 on paper." },
    "muted":        { "$value": "#68655f", "$description": "Paragraphs, leads, stage labels. Warm gray. 5.5:1 on paper, 5.8:1 on surface." },
    "navy":         { "$value": "#0d1440", "$description": "Primary dark: h1, prices, CTA label, utility bar, form panel, footer. 16.7:1 on paper." },
    "green":        { "$value": "#5fbf46", "$description": "Accent FILL only: CTA background, active-nav/input underlines, arrow discs. 2.2:1 as text on paper — never use as text on light grounds. Navy on green is 7.6:1." },
    "green-deep":   { "$value": "#3e9a2c", "$description": "Green as text: numerals, checkmarks, heading period, eyebrow text. 3.4:1 on paper — large/bold text and icons only." },
    "line":         { "$value": "#17140f1f", "$description": "Hairlines and dashed dividers (ink-brown at 12% alpha)." },
    "on-navy":      { "$value": "#ffffff", "$description": "Headings and input text on navy. 17.6:1." },
    "on-navy-soft": { "$value": "rgba(255, 255, 255, 0.8)", "$description": "Utility-bar text on navy." },
    "on-navy-link": { "$value": "rgba(255, 255, 255, 0.78)", "$description": "Footer links on navy." },
    "on-navy-body": { "$value": "rgba(255, 255, 255, 0.72)", "$description": "Paragraph text on navy (lead-form intro)." },
    "on-navy-muted":{ "$value": "rgba(255, 255, 255, 0.6)", "$description": "Form labels and secondary footer text on navy." },
    "on-navy-fill": { "$value": "rgba(255, 255, 255, 0.1)", "$description": "Subtle fills on navy (footer icon buttons)." },
    "logo-blue":    { "$value": "#1025a1", "$description": "Logo artwork only. Not used in UI (see brand/open-decisions.md)." },
    "logo-navy":    { "$value": "#0b1970", "$description": "Logo artwork only. Not used in UI." },
    "logo-green":   { "$value": "#7ed957", "$description": "Logo artwork only. Not used in UI; UI uses green #5fbf46." }
  },
  "font": {
    "$type": "fontFamily",
    "heading": { "$value": ["Poppins", "sans-serif"], "$description": "Headings, numerals, prices. Weights 600/700/800." },
    "sans":    { "$value": ["Raleway Variable", "Raleway", "Helvetica", "Arial", "sans-serif"], "$description": "Everything else. Site serves Raleway Variable via Fontsource; Google Fonts 'Raleway' is the equivalent." }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular":   { "$value": 400 },
    "semibold":  { "$value": 600 },
    "bold":      { "$value": 700 },
    "extrabold": { "$value": 800 }
  },
  "space": {
    "$type": "dimension",
    "$description": "Base unit 4px (Tailwind --spacing: .25rem). Names are Tailwind step numbers; only steps the site uses are listed.",
    "1-5": { "$value": "6px",  "$description": "Eyebrow vertical padding." },
    "3":   { "$value": "12px", "$description": "Secondary button horizontal padding." },
    "3-5": { "$value": "14px", "$description": "Eyebrow horizontal padding." },
    "4":   { "$value": "16px", "$description": "CTA vertical padding; mobile gutter." },
    "6-5": { "$value": "26px", "$description": "Gap below hero h1." },
    "7-5": { "$value": "30px", "$description": "Primary CTA horizontal padding (form submit: 34px)." },
    "8":   { "$value": "32px", "$description": "Section side padding; pricing cell vertical padding." },
    "9":   { "$value": "36px", "$description": "Pricing cell horizontal padding." },
    "14":  { "$value": "56px", "$description": "Footer top padding." },
    "16":  { "$value": "64px", "$description": "Lead-form panel padding." },
    "24":  { "$value": "96px", "$description": "Vertical padding of every content section." }
  },
  "radius": {
    "$type": "dimension",
    "pill":     { "$value": "9999px", "$description": "CTAs, eyebrow badges, icon buttons, arrow discs." },
    "panel":    { "$value": "26px",   "$description": "Navy lead-form panel." },
    "image":    { "$value": "22px",   "$description": "Hero photography." },
    "image-sm": { "$value": "20px",   "$description": "Secondary photography." },
    "2xl":      { "$value": "16px",   "$description": "Tailwind default, defined in the site theme." },
    "lg":       { "$value": "8px",    "$description": "Tailwind default, defined in the site theme." }
  },
  "border-width": {
    "$type": "dimension",
    "hairline":  { "$value": "1px", "$description": "Eyebrow border; dashed pricing dividers (color.line)." },
    "underline": { "$value": "2px", "$description": "Active nav (green), secondary CTA (navy), inputs (green)." }
  },
  "size": {
    "$type": "dimension",
    "container":        { "$value": "1240px", "$description": "Main content max width." },
    "container-narrow": { "$value": "660px",  "$description": "Prose block max width." },
    "logo-height":      { "$value": "36px",   "$description": "Header logo height." },
    "breakpoint-sm":    { "$value": "40rem",  "$description": "Tailwind sm (640px)." },
    "breakpoint-md":    { "$value": "48rem",  "$description": "Tailwind md (768px) — the main two-column switch." }
  },
  "duration": {
    "$type": "duration",
    "default": { "$value": "150ms", "$description": "Tailwind default transition; easing cubic-bezier(.4, 0, .2, 1)." }
  },
  "typography": {
    "$type": "typography",
    "display-1":   { "$value": { "fontFamily": "{font.heading}", "fontSize": "68px",   "fontWeight": 700, "lineHeight": 1.03,      "letterSpacing": "-1.7px" }, "$description": "Hero h1, navy. One per page.", "$extensions": { "com.domkirbycreative": { "fluid": "clamp(40px, 5.2vw, 68px)", "letterSpacingEm": "-0.025em", "color": "{color.navy}" } } },
    "display-2":   { "$value": { "fontFamily": "{font.heading}", "fontSize": "40px",   "fontWeight": 700, "lineHeight": "50px",    "letterSpacing": "-1px" },   "$description": "Section h2, ink.", "$extensions": { "com.domkirbycreative": { "fluid": "clamp(28px, 3.4vw, 40px)", "letterSpacingEm": "-0.025em", "color": "{color.ink}" } } },
    "form-title":  { "$value": { "fontFamily": "{font.heading}", "fontSize": "36px",   "fontWeight": 700, "lineHeight": "54px",    "letterSpacing": "-0.9px" }, "$description": "Heading in the navy lead-form panel, on-navy." },
    "numeral":     { "$value": { "fontFamily": "{font.heading}", "fontSize": "38px",   "fontWeight": 800, "lineHeight": 1,         "letterSpacing": "0px" },    "$description": "Process step numbers 01–04, green-deep." },
    "price":       { "$value": { "fontFamily": "{font.heading}", "fontSize": "32px",   "fontWeight": 800, "lineHeight": "normal",  "letterSpacing": "0px" },    "$description": "Dollar figures, navy." },
    "numeral-sm":  { "$value": { "fontFamily": "{font.heading}", "fontSize": "28px",   "fontWeight": 800, "lineHeight": "28px",    "letterSpacing": "0px" },    "$description": "Pricing stage numbers, green-deep." },
    "title-sm":    { "$value": { "fontFamily": "{font.heading}", "fontSize": "15.5px", "fontWeight": 700, "lineHeight": "23.25px", "letterSpacing": "0px" },    "$description": "Stage titles (h3), ink." },
    "stage-label": { "$value": { "fontFamily": "{font.heading}", "fontSize": "14px",   "fontWeight": 700, "lineHeight": "20px",    "letterSpacing": "0.35px" }, "$description": "Uppercase stage name in pricing cells, muted.", "$extensions": { "com.domkirbycreative": { "textTransform": "uppercase" } } },
    "price-unit":  { "$value": { "fontFamily": "{font.heading}", "fontSize": "14px",   "fontWeight": 600, "lineHeight": "21px",    "letterSpacing": "0px" },    "$description": "'one-time' / 'per month' after a price, muted." },
    "lead":        { "$value": { "fontFamily": "{font.sans}",    "fontSize": "19px",   "fontWeight": 400, "lineHeight": "31px",    "letterSpacing": "0px" },    "$description": "Hero subhead and section intros, muted." },
    "body":        { "$value": { "fontFamily": "{font.sans}",    "fontSize": "16px",   "fontWeight": 400, "lineHeight": "24px",    "letterSpacing": "0px" },    "$description": "Default body copy." },
    "body-sm":     { "$value": { "fontFamily": "{font.sans}",    "fontSize": "14px",   "fontWeight": 400, "lineHeight": "22.75px", "letterSpacing": "0px" },    "$description": "Process-step descriptions; checklists (21px line height)." },
    "caption":     { "$value": { "fontFamily": "{font.sans}",    "fontSize": "13.5px", "fontWeight": 400, "lineHeight": "21.94px", "letterSpacing": "0px" },    "$description": "Pricing-cell description, muted." },
    "nav":         { "$value": { "fontFamily": "{font.sans}",    "fontSize": "15px",   "fontWeight": 600, "lineHeight": "normal",  "letterSpacing": "0px" },    "$description": "Header nav links, navy." },
    "button":      { "$value": { "fontFamily": "{font.sans}",    "fontSize": "15.5px", "fontWeight": 700, "lineHeight": "normal",  "letterSpacing": "0px" },    "$description": "CTA labels. Sentence case." },
    "label":       { "$value": { "fontFamily": "{font.sans}",    "fontSize": "13px",   "fontWeight": 600, "lineHeight": "normal",  "letterSpacing": "0px" },    "$description": "Form labels, on-navy-muted." },
    "utility":     { "$value": { "fontFamily": "{font.sans}",    "fontSize": "13px",   "fontWeight": 400, "lineHeight": "normal",  "letterSpacing": "0px" },    "$description": "Top utility bar, on-navy-soft." },
    "eyebrow":     { "$value": { "fontFamily": "{font.sans}",    "fontSize": "12px",   "fontWeight": 700, "lineHeight": "normal",  "letterSpacing": "0.3px" },  "$description": "Pill badge above the h1, green-deep on paper-2.", "$extensions": { "com.domkirbycreative": { "textTransform": "uppercase" } } }
  }
}
